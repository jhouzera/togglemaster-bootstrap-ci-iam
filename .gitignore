# Terraform: diretório local, state e logs
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Valores da conta. terraform.tfvars.example é o modelo versionado.
*.tfvars
*.tfvars.json

# Planos salvos guardam os valores em claro
tfplan
*.tfplan

# Overrides e configuração local da CLI
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Perfis de VPN e chaves baixados localmente
*.ovpn
*.pem
*.key

# Instruções locais do Claude Code: não são versionadas
CLAUDE.md
