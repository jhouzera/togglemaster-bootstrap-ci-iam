aws_region  = "us-east-1"
aws_profile = ""

project_name = "togglemaster"
environment  = "dev"

tfstate_bucket_name = "togglemaster-dev-tfstate-123456789012"

create_github_oidc_provider = true
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
create_tfstate_bucket = true
create_iam_roles      = true
create_iam_policies   = true

github_owner = "jhouzera"

secrets_generator_github_repository = "togglemaster-secrets-generator"

# VPN de administracao (OpenVPN) — ver vpn.tf
vpn_instance_type     = "t3.micro"
vpn_vpc_cidr          = "10.100.0.0/24"
vpn_subnet_cidr       = "10.100.0.0/26"
vpn_availability_zone = "us-east-1a"
vpn_allowed_cidrs     = ["0.0.0.0/0"]
vpn_routed_cidrs      = ["10.20.0.0/16"]
vpn_clients           = ["admin", "github-actions"]
